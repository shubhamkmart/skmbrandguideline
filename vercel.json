{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "npm run build && npm run check && npm test",
  "outputDirectory": "dist",
  "trailingSlash": true,
  "functions": {
    "api/brand-chat.mjs": {"maxDuration": 30},
    "api/mcp.mjs": {
      "maxDuration": 30,
      "includeFiles": "{public/assets/logo-bag-only-*,dist/brand-guide.txt,dist/assets/skm-*}"
    }
  },
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {"key": "X-Content-Type-Options", "value": "nosniff"},
        {"key": "Referrer-Policy", "value": "strict-origin-when-cross-origin"}
      ]
    }
  ]
}
